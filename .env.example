# --- Core / Environment ---
ENV=dev
RUN_IN_DOCKER=false
DEBUG=false

# --- Providers ---
PROVIDERS_DEFAULT_NAME=diffusers
PROVIDERS_ENABLED=["diffusers"]

# --- Feature Flags ---
FEATURE_FLAGS={"image_generation": true, "image_editing": true, "image_upscaling": true, "ip_adapter": true, "batch_generation": true}

# --- Inference/model ---
MODEL_ID=models/dreamshaper_6NoVae.safetensors
DEVICE=cuda
MAX_STEPS=128
MAX_SIZE=2048
GENERATION_TIMEOUT_SEC=300
VAE_ID=models/vae # | for offline version
# VAE_ID=stabilityai/sd-vae-ft-mse # | for online version
TORCH_DTYPE=fp16
SCHEDULER=
SEED_STRICT=false

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/amaimagery

# --- Security ---
SECRET_KEY=CHANGE_ME_LONG_RANDOM
JWT_ALG=HS256

# --- Logging ---
LOG_DIR=logs
LOG_LEVEL=INFO
LOG_ROTATION=00:00
LOG_RETENTION=30 days
LOG_COMPRESSION=zip
PROMPTS_RAW=0
LOG_MASK_AUTH=true

# SMTP
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com
SMTP_SECURITY=starttls
SMTP_TIMEOUT_SEC=15

# --- General toggles ---
AUTOCORRECT=on
BASE_URL=

# Links in emails
FRONTEND_ORIGIN=http://localhost:5173

# TTL for password reset tokens (minutes)
RESET_TOKEN_TTL_MIN=30

# allowed hosts
ALLOWED_HOSTS=["localhost","127.0.0.1"]

# --- Redis (for rate-limits, queues, etc) ---
REDIS_URL=redis://localhost:6379/0
NO_REDIS=false
ENABLE_HSTS=false

# Limits
GEN_PER_USER_PER_MIN=60
GEN_PER_IP_PER_MIN=120
LIMITS_ENABLED=true

# Concurrency
QUEUE_WAIT_TIMEOUT_SEC=2.0

# --- Files ---
FILE_SIGNING_ENABLED=true
FILE_URL_TTL_SEC=86400
FILE_DOWNLOAD_TTL_SEC=900
FILE_SINGLE_USE=false
FILE_ALLOWED_EXTS=["png","jpg","jpeg","webp"]
FILE_ALLOWED_MIMES=["image/png","image/jpeg","image/webp"]

# --- Auth: JWT, tokens, bcrypt ---
ACCESS_TTL_MIN=15
REVOKE_PREFIX=jwt:bl:

# --- NSFW ---
NSFW_ALLOW=false
NSFW_BLOCKLIST_PATH=app/config/nsfw_blocklist.txt

# --- Auth: cookies, bcrypt ---
REFRESH_COOKIE_NAME=refresh_token
REFRESH_TTL_DAYS=14
REFRESH_COOKIE_SECURE=true
BCRYPT_ROUNDS=12

# --- API limits/timeouts ---
MAX_BODY_BYTES=26214400
MAX_QUERY_VALUE_LEN=512
REQUEST_TIMEOUT_SECONDS=30
KEEPALIVE_TIMEOUT_SECONDS=5

# --- Hugging Face and offline caches ---
HF_HUB_OFFLINE=false
TRANSFORMERS_OFFLINE=false
DIFFUSERS_OFFLINE=false
HF_HOME=
HUGGINGFACE_HUB_CACHE=
TRANSFORMERS_CACHE=
HF_TOKEN=

# --- Anti-DoS: generation ---
MAX_CONCURRENT_GENERATIONS=2

# --- Inference: security ---
NO_NETWORK=true
MAX_GEN_WIDTH=1024
MAX_GEN_HEIGHT=1024
MAX_GEN_STEPS=128
MAX_GUIDANCE=20.0
MAX_BATCH=4

# --- Torch resourses ---
TORCH_THREADS=2
CUDA_VRAM_FRACTION=0.95

# --- Metrics --
METRICS_ENABLED=true
GPU_METRICS_ENABLED=true
METRICS_PATH=/metrics

# --- Docs and UI ---
DOCS_URL=/docs
UI_STATIC_DIR=

# --- Paths ---
OUTPUTS_DIR=outputs
IP_ADAPTER_DIR=models/ip-adapter
IP_IMAGE_ENCODER_PATH=models/ip-adapter/image_encoder