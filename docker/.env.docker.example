# --- Project ---
COMPOSE_PROJECT_NAME=genai_local

# --- Application ---
ENV=dev
DEBUG=true
SECRET_KEY=CHANGE_ME_IN_PROD_PLEASE
DEVICE=cpu

# --- Database (Container Config) ---
POSTGRES_USER=appuser
POSTGRES_PASSWORD=change_me
POSTGRES_DB=genai_db

# --- Database (App Connection) ---
DATABASE_URL=postgresql+asyncpg://appuser:change_me@postgres:5432/genai_db

# --- Redis ---
REDIS_PASSWORD=change_me
REDIS_URL=redis://:change_me@redis:6379/0

# --- Frontend ---
FRONTEND_ORIGIN=http://localhost:8080
UI_MOUNT_ENABLED=true
UI_STATIC_DIR=/app/static

# --- Paths & Models ---
HF_HOME=/root/.cache/huggingface
HUGGINGFACE_HUB_CACHE=/root/.cache/huggingface/hub
TRANSFORMERS_CACHE=/root/.cache/huggingface/hub
HF_HUB_DISABLE_TELEMETRY=1