# --- Project ---
COMPOSE_PROJECT_NAME=amaimagery-prod

# --- Application ---
ENV=prod
DEBUG=false
RUN_IN_DOCKER=1
SECRET_KEY=CHANGE_ME_LONG_RANDOM
JWT_ALG=HS256
BASE_URL=https://example.com
FRONTEND_ORIGIN=https://example.com
REFRESH_COOKIE_SECURE=true
ENABLE_HSTS=true
ALLOWED_HOSTS=["example.com","localhost","127.0.0.1"]
UI_STATIC_DIR=/app/static

# --- Database ---
PGROOT_PASSWORD=CHANGE_ME
APP_DB_PASSWORD=CHANGE_ME
MIGRATOR_PASSWORD=CHANGE_ME
PGUSER=app
PGDATABASE=appdb
DATABASE_URL=postgresql+asyncpg://app:CHANGE_ME@postgres:5432/appdb

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME
REDIS_URL=redis://:CHANGE_ME@redis:6379/0

# --- Providers ---
PROVIDERS_ENABLED=comfyui
PROVIDERS_DEFAULT_NAME=comfyui
COMFYUI_BASE_URL=http://host.docker.internal:8188
COMFYUI_WEBSOCKET_URL=ws://host.docker.internal:8188/ws
COMFYUI_POLL_INTERVAL_SEC=1.5
COMFYUI_TIMEOUT_SEC=300

# --- Runtime / Security ---
NO_NETWORK=true
DEVICE=cuda

# --- Paths / Caches ---
OUTPUTS_DIR=/app/outputs
LOG_DIR=/app/logs
HF_HOME=/root/.cache/huggingface
HUGGINGFACE_HUB_CACHE=/root/.cache/huggingface/hub
TRANSFORMERS_CACHE=/root/.cache/huggingface/hub
