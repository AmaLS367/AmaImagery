{
  "compilerOptions": {
    "target": "ES2020",
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["vitest/globals", "node", "vite/client"],
    "strict": true,
    "paths": {
      "@src/*": [
        "../../frontend/src/*"
      ]
    }
  },
  "include": [
    "unit/**/*.ts",
    "unit/**/*.tsx"
  ]
}
